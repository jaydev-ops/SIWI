# ==============================================================================
# SIWI GLOBAL VENTURES — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
PORT=3001
NODE_ENV=development

# Database (PostgreSQL for Production Deployment / SQLite for Local Embedded)
DATABASE_URL="postgresql://siwi_user:siwi_password@localhost:5432/siwi_db?schema=public"

# ==============================================================================
# S3-COMPATIBLE OBJECT STORAGE (AWS S3, Cloudflare R2, MinIO, Wasabi)
# If omitted or left empty, SIWI automatically falls back to the persistent
# LocalStorageProvider at storage/uploads for development testing.
# ==============================================================================
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=siwi-product-media
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY
S3_PUBLIC_URL=https://media.siwiglobal.com
S3_FORCE_PATH_STYLE=false

# Media Pipeline Configuration
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml"
